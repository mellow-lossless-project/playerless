<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/topBarBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/searchIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/pressed_bar"
            android:contentDescription="@string/search_hint"
            android:src="@drawable/ic_search"
            android:tint="?attr/barIcon" />

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingEnd="16dp"
            android:textColor="?attr/barText"
            android:textColorHint="?attr/barTextDim" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/titleRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/listTitle"
            style="?attr/titleStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/shuffleAll"
            style="@style/IconButton"
            android:contentDescription="@string/shuffle_all"
            android:src="@drawable/ic_shuffle" />

        <ImageButton
            android:id="@+id/playAll"
            style="@style/IconButton"
            android:contentDescription="@string/play_all"
            android:src="@drawable/ic_play" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="?attr/textDim"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <!-- What the player is doing while a song loads; gone as soon as it plays. -->
        <TextView
            android:id="@+id/loadLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="?attr/panelColor"
            android:fontFamily="monospace"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:textColor="?attr/panelText"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/playerBarBackground"
        android:foreground="@drawable/pressed_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playerTitle"
                style="?attr/rowTitleStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/barText" />

            <TextView
                android:id="@+id/playerArtist"
                style="?attr/rowSubtitleStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/barTextDim" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/prev"
            style="@style/BarIconButton"
            android:contentDescription="@string/previous"
            android:src="@drawable/ic_prev" />

        <ImageButton
            android:id="@+id/playPause"
            style="@style/BarIconButton"
            android:contentDescription="@string/play_pause"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/next"
            style="@style/BarIconButton"
            android:contentDescription="@string/next"
            android:src="@drawable/ic_next" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="?android:attr/colorAccent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/barColor"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/navHome"
            style="@style/NavButton"
            android:contentDescription="@string/home"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/navDownloads"
            style="@style/NavButton"
            android:contentDescription="@string/downloads"
            android:src="@drawable/ic_download" />

        <ImageButton
            android:id="@+id/navSettings"
            style="@style/NavButton"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>
</LinearLayout>
