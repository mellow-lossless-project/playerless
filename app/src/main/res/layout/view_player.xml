<?xml version="1.0" encoding="utf-8"?>
<!-- The page behind it is set in code: the poster themes print theirs with grain. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pageColor"
    android:clickable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="32dp">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/fullTitle"
        style="?attr/playerTitleStyle"
        android:layout_width="match_parent" />

    <TextView
        android:id="@+id/fullArtist"
        style="?attr/playerArtistStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- In the poster themes the cover is printed in two inks; a finger on it shows the real one. -->
    <com.playerless.SquareLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/placeholderColor"
        android:foreground="?attr/coverFrame">

        <ImageView
            android:id="@+id/fullCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </com.playerless.SquareLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <SeekBar
        android:id="@+id/fullProgress"
        style="@style/PlayerBar"
        android:contentDescription="@string/progress" />

    <!-- Pulled up into the bar's touch area, so the times sit right under the bar. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/fullElapsed"
            style="@style/PlayerTime"
            android:layout_width="wrap_content" />

        <!-- What the song really plays from, in what quality: lossless or not, at a glance. -->
        <TextView
            android:id="@+id/fullQuality"
            style="@style/PlayerTime"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="8dp" />

        <TextView
            android:id="@+id/fullLength"
            style="@style/PlayerTime"
            android:layout_width="wrap_content" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/fullPrev"
            style="@style/PlayerButton"
            android:contentDescription="@string/previous"
            android:src="@drawable/ic_prev" />

        <ImageButton
            android:id="@+id/fullPlayPause"
            style="@style/PlayerButton"
            android:contentDescription="@string/play_pause"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/fullNext"
            style="@style/PlayerButton"
            android:contentDescription="@string/next"
            android:src="@drawable/ic_next" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <SeekBar
        android:id="@+id/fullVolume"
        style="@style/PlayerBar"
        android:contentDescription="@string/volume" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
