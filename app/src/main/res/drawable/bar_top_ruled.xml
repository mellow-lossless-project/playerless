<?xml version="1.0" encoding="utf-8"?>
<!-- A bar the color of the page, set off from it by a printed rule underneath. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="?attr/barColor" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="bottom">
        <shape>
            <solid android:color="?attr/frameColor" />
        </shape>
    </item>
</layer-list>
